# Which LLM provider to use: "openai" (default) or "ollama"
LLM_PROVIDER=openai

# OpenAI-compatible endpoint (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama local endpoint (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Server port (client dev server runs on 5173 and proxies /api here)
PORT=3001
